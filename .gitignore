# Python cache and build outputs
__pycache__/
*.py[cod]
*.pyo
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/

# Test / tooling / coverage
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Model artifacts and binary models
models/artifacts/*
