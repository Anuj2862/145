*.joblib
*.pkl

# Processed dataset exports
dataset/processed/*.csv
!dataset/processed/.gitkeep

# PCAP captures
*.pcap
*.pcapng

# Logs
*.log

# IDE and OS settings
.vscode/
.idea/
.DS_Store
Thumbs.db
